<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_nothing"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Top Header: Red Dot + Title + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Nothing Red Accent Dot -->
        <View
            android:id="@+id/widget_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_notif_circle_red" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ROUTINEFORGE // 4-DIGIT"
            android:textColor="#BBBBBB"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textColor="#D71921"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#222222" />

    <!-- 4-NUMBER MONOSPACE DISPLAY -->
    <LinearLayout
        android:id="@+id/widget_digits_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp">

        <!-- Digits MM (Minutes: e.g. 05) -->
        <TextView
            android:id="@+id/widget_digit_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:includeFontPadding="false" />

        <!-- Delimiter Colon -->
        <TextView
            android:id="@+id/widget_colon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text=":"
            android:textColor="#D71921"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:includeFontPadding="false" />

        <!-- Digits SS (Seconds: e.g. 00) -->
        <TextView
            android:id="@+id/widget_digit_ss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Bottom Actions: Preset chips & Start Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_chip_5m"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill"
            android:text="5M"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_chip_15m"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_pill"
            android:text="15M"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_chip_25m"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_pill"
            android:text="25M"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <!-- Start/Open Action Button (Nothing Red) -->
        <ImageView
            android:id="@+id/widget_btn_action"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_circle_red"
            android:src="@drawable/ic_notif_play"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="Start Timer" />
    </LinearLayout>

</LinearLayout>
