<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the ongoing notifications and the home widget: icon, big time, subtitle, round buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/live_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_notification_timer"
        android:tint="@color/live_accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Ticks by itself while running; the static text is shown when paused or idle. -->
        <Chronometer
            android:id="@+id/live_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/live_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/live_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/live_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/live_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/live_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_live_circle_accent"
        android:contentDescription="Pause"
        android:padding="10dp"
        android:src="@drawable/ic_notif_pause" />

    <ImageView
        android:id="@+id/live_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_live_circle_secondary"
        android:contentDescription="Stop"
        android:padding="12dp"
        android:src="@drawable/ic_notif_close"
        android:tint="@color/live_btn_secondary_icon" />
</LinearLayout>
