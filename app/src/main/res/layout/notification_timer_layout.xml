<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Right Controls (Circular Buttons matching reference design) -->
    <LinearLayout
        android:id="@+id/notif_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Circular Play / Pause Button (Nothing Red) -->
        <ImageView
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_notif_circle_red"
            android:src="@drawable/ic_notif_pause"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play/Pause" />

        <!-- Circular Next Step Button (Dark) -->
        <ImageView
            android:id="@+id/notif_btn_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_notif_circle_dark"
            android:src="@drawable/ic_notif_next"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Next Step" />

        <!-- Circular Stop / Close Button (Dark X) -->
        <ImageView
            android:id="@+id/notif_btn_stop"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_notif_circle_dark"
            android:src="@drawable/ic_notif_close"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Stop Routine" />
    </LinearLayout>

    <!-- Center Timer & Details (fills entire space to the left of controls: only timer & task) -->
    <LinearLayout
        android:id="@+id/notif_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/notif_controls"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <!-- Bold Countdown Display -->
        <TextView
            android:id="@+id/notif_timer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false" />

        <!-- Subtask Title (Active Task Name Only) -->
        <TextView
            android:id="@+id/notif_subtask_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Step"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="#EEFFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</RelativeLayout>
