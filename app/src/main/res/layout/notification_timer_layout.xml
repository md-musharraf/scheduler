<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Right Controls (Circular Buttons matching reference design) -->
    <LinearLayout
        android:id="@+id/notif_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Circular Play / Pause Button (Nothing Red) -->
        <ImageView
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_notif_circle_red"
            android:src="@drawable/ic_notif_pause"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play/Pause" />

        <!-- Circular Next Step Button (Dark) -->
        <ImageView
            android:id="@+id/notif_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_circle_dark"
            android:src="@drawable/ic_notif_next"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Next Step" />

        <!-- Circular Stop / Close Button (Dark X) -->
        <ImageView
            android:id="@+id/notif_btn_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_circle_dark"
            android:src="@drawable/ic_notif_close"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Stop Routine" />
    </LinearLayout>

    <!-- Center Timer & Details (fills entire space to the left of controls) -->
    <LinearLayout
        android:id="@+id/notif_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/notif_controls"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <!-- Huge Bold Countdown Display (Never wraps) -->
        <TextView
            android:id="@+id/notif_timer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- Subtask Title (Active Step) -->
        <TextView
            android:id="@+id/notif_subtask_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Step"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Parent Category Progress -->
        <TextView
            android:id="@+id/notif_category_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category • 00:00 Left"
            android:textSize="11sp"
            android:textColor="#FFAAAAAA"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

</RelativeLayout>
